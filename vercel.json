{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "abir-s-portfolio-eight.vercel.app" }],
      "destination": "https://www.hossainabir.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
